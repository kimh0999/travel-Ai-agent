# ===== 백엔드 (backend/.env 로 복사해서 사용, Render에서는 환경변수로 등록) =====
# 서버 비밀값: 프론트 코드나 Git에 넣지 마세요.
ANTHROPIC_API_KEY=
# Claude 모델. 기본 claude-opus-5-5 (입력 $4 / 출력 $20 per 1M 토큰).
# 비용을 줄이려면 claude-sonnet-5-5 (입력 $2 / 출력 $10). 실제 연결은 scripts/check_live_claude.py로 확인.
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (claude-opus-5-5 기본값은 medium)
CLAUDE_EFFORT=medium
AI_TIMEOUT=120
AI_MAX_RETRIES=2

# 서비스 계정 JSON 문자열 전체 또는 JSON 파일 경로
FIREBASE_SERVICE_ACCOUNT_JSON=
# 서비스 계정에 project_id가 있으면 생략 가능. 에뮬레이터 사용 시 필수(예: demo-travel)
FIREBASE_PROJECT_ID=

# 쉼표로 구분한 허용 출처(프론트 배포 URL)
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

KAKAO_REST_API_KEY=

# live | mock  (mock: Claude 호출 없이 결정적인 모의 응답, 화면에 '모의 응답' 표시)
AI_MODE=mock
# kakao | mock (mock: 모의 장소 데이터, 화면에 '모의 장소 데이터' 표시)
PLACE_PROVIDER=mock

# 로컬 에뮬레이터 사용 시에만 설정
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ===== 프론트엔드 (Vercel 환경변수, 공개값만) =====
# API_BASE_URL=https://<render-service>.onrender.com
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=<project>.firebaseapp.com
# FIREBASE_PROJECT_ID=<project>
# FIREBASE_APP_ID=
# 로컬 개발에서 Auth 에뮬레이터를 쓸 때만
# USE_AUTH_EMULATOR=true
